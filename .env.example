# ==== قاعدة البيانات المحلية SQLite ====
# استخدم مسارًا دائمًا وقابلاً للكتابة بواسطة مستخدم الخدمة.
LOCAL_DB_PATH=/var/lib/shifaa/content-hub.sqlite

# ==== المدير المحلي الأول ====
# تُستخدم هذه القيم فقط عندما تكون قاعدة البيانات فارغة.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-10-characters

# ==== تشفير أسرار التطبيق المخزنة داخل SQLite ====
# قيمة عشوائية طويلة وثابتة؛ تغييرها لاحقًا يمنع فك الأسرار القديمة.
APP_SECRETS_KEY=replace-with-a-long-random-secret

# ==== البريد (Resend بوابة إرسال فقط) ====
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=Shifaa Content Hub <noreply@shifaa.at>

# ==== اختياري للترجمة، ويمكن ضبطه أيضًا من لوحة الإدارة ====
OPENAI_API_KEY=

# ==== الخادم ====
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
